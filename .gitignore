# 依赖
node_modules/
.pnpm-store/

# 构建产物
dist/
release/
apps/desktop/release/
apps/web-next/dist/

# 运行时数据（设备身份 / 数据库 / 缓存 / 日志）——绝不入库
data/
.data/
*.db
*.db-wal
*.db-shm
*.log
npm-debug.log*

# 打包用的第三方二进制（按 README「打包」一节自备，不入库）
apps/desktop/resources/ffmpeg/
apps/desktop/resources/hgsigner/
apps/desktop/resources/launcher/*.exe
apps/desktop/vendor/

# 逆向/抓包/调试用的临时目录
.tmp/
.research/
.tools/

# 编辑器 / 系统
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
